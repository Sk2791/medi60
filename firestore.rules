rules_version = '2';
// Medi60 demo rules: anyone with the link can use only the four collections the prototype needs,
// and only until the date below. Change the date (or lock it down) after the course.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read, write: if col in ['medi60', 'orders', 'cmds', '_leases']
                         && request.time < timestamp.date(2027, 3, 31);
    }
  }
}
